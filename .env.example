# ── 模型接入（只在服务端读取）────────────────────────────
# 自配 OpenAI 兼容接口（默认 DeepSeek）。填了就优先使用。
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 复盘时的思考强度：none / low / high / max（规划固定 none，保证速度）
AI_REASONING_EFFORT=low

# Kimi 平台部署时会自动注入，无需手填：
# KIMI_AGENTGW_API_KEY=
# KIMI_AGENTGW_BASE_URL=

# ── 平台模板变量（本应用未使用，可留空）──────────────────
APP_ID=
APP_SECRET=
DATABASE_URL=
